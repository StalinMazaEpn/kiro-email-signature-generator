<!-- Email Signature: Moderna con Banner -->
<!-- Two-column layout: photo left with gradient, contact data right -->
<table cellpadding="0" cellspacing="0" border="0" style="font-family: Arial, Helvetica, sans-serif; background-color: #f4f7f6; border-radius: 16px; overflow: hidden; width: 550px; border-collapse: separate;">
  <tr>
    <!-- LEFT SIDE: GRADIENT + PHOTO -->
    <td width="220" align="center" valign="bottom" style="background-color: #1f363d; background-image: linear-gradient(180deg, #1f363d 0%, #40798c 100%); padding: 15px 10px 0px 10px; text-align: center;">
      <!-- Photo Frame -->
      <table cellpadding="0" cellspacing="0" border="0" width="100%">
        <tr>
          <td align="center" valign="bottom" style="background-color: #70a9a1; border-top-left-radius: 20px; border-top-right-radius: 20px; padding-top: 10px;">
            <img src="{{{bannerUrl}}}" alt="{{nombre}}" width="170" height="170" style="display: block; width: 100%; max-width: 170px; height: auto; border-top-left-radius: 15px; border-top-right-radius: 15px;" />
          </td>
        </tr>
      </table>
    </td>

    <!-- RIGHT SIDE: CONTACT DATA -->
    <td valign="top" style="padding: 25px 20px 20px 25px; background-color: #cfe0c3;">
      <!-- Name and Title -->
      <div style="font-size: 18px; font-weight: bold; color: #1f363d; margin-bottom: 2px;">
        {{nombre}}
      </div>
      <div style="font-size: 12px; font-weight: 600; color: #40798c; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 12px;">
        {{cargo}}
      </div>

      <!-- Separator Line -->
      <div style="border-bottom: 2px solid #70a9a1; width: 100%; margin-bottom: 15px;"></div>

      <!-- Contact Info -->
      <table cellpadding="0" cellspacing="0" border="0" style="font-size: 12px; color: #1f363d; line-height: 20px;">
        <tr>
          <td style="font-weight: bold; padding-right: 8px; color: #40798c;">T:</td>
          <td><a href="tel:{{telefono}}" style="color: #1f363d; text-decoration: none;">{{telefono}}</a></td>
        </tr>
        <tr>
          <td style="font-weight: bold; padding-right: 8px; color: #40798c;">E:</td>
          <td><a href="mailto:{{email}}" style="color: #1f363d; text-decoration: none;">{{email}}</a></td>
        </tr>
        {{#website}}
        <tr>
          <td colspan="2" style="padding-top: 4px;">
            <a href="{{{website}}}" target="_blank" style="font-weight: bold; color: #1f363d; text-decoration: none;">Web</a>
          </td>
        </tr>
        {{/website}}
      </table>

      <!-- Social Links -->
      {{#linkedin}}
      <table cellpadding="0" cellspacing="0" border="0" style="margin-top: 20px; width: 100%;">
        <tr>
          <td align="right">
            <a href="{{{linkedin}}}" target="_blank" style="display: inline-block; width: 28px; height: 28px; background-color: #40798c; color: #ffffff; border-radius: 50%; text-align: center; line-height: 28px; text-decoration: none; font-size: 12px; font-weight: bold;">in</a>
          </td>
        </tr>
      </table>
      {{/linkedin}}
    </td>
  </tr>
</table>
