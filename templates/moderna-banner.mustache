<!-- Email Signature: Moderna con Banner -->
<!-- Two-column layout: photo left with gradient, contact data right -->
<table cellpadding="0" cellspacing="0" border="0" style="font-family: Arial, Helvetica, sans-serif; background-color: #f4f7f6; border-radius: 16px; overflow: hidden; width: 550px; border-collapse: separate;">
  <tr>
    <!-- LEFT SIDE: GRADIENT + PHOTO -->
    <td width="200" align="center" valign="bottom" style="background-color: #40798c; padding: 0; text-align: center; vertical-align: bottom;">
      <img src="{{{bannerUrl}}}" alt="{{nombre}}" width="200" height="260" style="display: block; width: 200px; height: 260px;" />
    </td>

    <!-- RIGHT SIDE: CONTACT DATA -->
    <td valign="top" style="padding: 25px 20px 20px 25px; background-color: #cfe0c3;">
      <!-- Name and Title -->
      <div style="font-size: 18px; font-weight: bold; color: #1f363d; margin-bottom: 2px;">
        {{nombre}}
      </div>
      <div style="font-size: 11px; font-weight: 600; color: #40798c; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 14px;">
        {{cargo}}
      </div>

      <!-- Separator Line -->
      <div style="border-bottom: 2px solid #70a9a1; width: 100%; margin-bottom: 14px;"></div>

      <!-- Contact Info -->
      <table cellpadding="0" cellspacing="0" border="0" style="font-size: 12px; color: #1f363d; line-height: 22px;">
        <tr>
          <td style="font-weight: bold; padding-right: 8px; color: #40798c; vertical-align: top;">T:</td>
          <td><a href="tel:{{telefono}}" style="color: #1f363d; text-decoration: none;">{{telefono}}</a></td>
        </tr>
        <tr>
          <td style="font-weight: bold; padding-right: 8px; color: #40798c; vertical-align: top;">E:</td>
          <td><a href="mailto:{{email}}" style="color: #1f363d; text-decoration: none;">{{email}}</a></td>
        </tr>
      </table>

      <!-- Social Icons Row -->
      <table cellpadding="0" cellspacing="0" border="0" style="margin-top: 18px; border-collapse: collapse;">
        <tr>
          {{#website}}
          <td style="padding-right: 6px;">
            <a href="{{{website}}}" target="_blank" style="display: inline-block; height: 26px; padding: 0 8px; background-color: #40798c; color: #ffffff; border-radius: 13px; text-align: center; line-height: 26px; text-decoration: none; font-size: 10px; font-weight: bold;">Web</a>
          </td>
          {{/website}}
          {{#linkedin}}
          <td style="padding-right: 6px;">
            <a href="{{{linkedin}}}" target="_blank" style="display: inline-block; width: 26px; height: 26px; background-color: #40798c; color: #ffffff; border-radius: 50%; text-align: center; line-height: 26px; text-decoration: none; font-size: 11px; font-weight: bold;">in</a>
          </td>
          {{/linkedin}}
        </tr>
      </table>
    </td>
  </tr>
</table>
