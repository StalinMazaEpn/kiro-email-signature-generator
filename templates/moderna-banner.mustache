<!-- Email Signature: Moderna con Banner -->
<!-- Horizontal banner on top, centered info below -->
<table cellpadding="0" cellspacing="0" border="0" style="width:600px;font-family:Arial,Helvetica,sans-serif;color:#333333;border-collapse:collapse;">
  <tr>
    <td style="padding:0;">
      <img src="{{{bannerUrl}}}" width="600" height="120" alt="Banner {{nombre}}" style="display:block;border:0;width:600px;height:120px;object-fit:cover;" />
    </td>
  </tr>
  <tr>
    <td style="padding:16px 0 0 0;text-align:center;">
      <strong style="font-size:18px;color:#1a1a2e;display:inline;">{{nombre}}</strong>
    </td>
  </tr>
  <tr>
    <td style="padding:4px 0 12px 0;text-align:center;">
      <span style="font-size:13px;color:#6b7280;">{{cargo}}</span>
    </td>
  </tr>
  <tr>
    <td style="padding:0;text-align:center;border-top:1px solid #e5e7eb;padding-top:12px;">
      <table cellpadding="0" cellspacing="0" border="0" style="margin:0 auto;border-collapse:collapse;">
        <tr>
          <td style="padding:0 12px;">
            <a href="mailto:{{email}}" style="font-size:12px;color:#2563eb;text-decoration:none;">&#9993; {{email}}</a>
          </td>
          <td style="padding:0 12px;border-left:1px solid #e5e7eb;">
            <span style="font-size:12px;color:#333333;">&#9742; {{telefono}}</span>
          </td>
          {{#website}}
          <td style="padding:0 12px;border-left:1px solid #e5e7eb;">
            <a href="{{{website}}}" style="font-size:12px;color:#2563eb;text-decoration:none;">&#127760; Web</a>
          </td>
          {{/website}}
          {{#linkedin}}
          <td style="padding:0 12px;border-left:1px solid #e5e7eb;">
            <a href="{{{linkedin}}}" style="font-size:12px;color:#2563eb;text-decoration:none;">in LinkedIn</a>
          </td>
          {{/linkedin}}
        </tr>
      </table>
    </td>
  </tr>
</table>
