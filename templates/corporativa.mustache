<!-- Email Signature: Corporativa -->
<!-- Two-column: photo left with accent border, contact info right -->
<table cellpadding="0" cellspacing="0" border="0" style="width: 550px; font-family: Arial, Helvetica, sans-serif; color: #1f363d; border-collapse: collapse;">
  <tr>
    <!-- Photo -->
    <td style="vertical-align: top; width: 140px; padding: 0;">
      <img src="{{{bannerUrl}}}" alt="{{nombre}}" width="130" height="130" style="display: block; width: 130px; height: 130px; border: 3px solid #70a9a1;" />
    </td>

    <!-- Separator -->
    <td style="width: 20px; vertical-align: top; padding: 10px 0;">
      <div style="width: 2px; height: 110px; background-color: #9ec1a3; margin: 0 auto;"></div>
    </td>

    <!-- Contact Info -->
    <td style="vertical-align: top; padding: 5px 0 0 0;">
      <table cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse;">
        <tr>
          <td style="padding: 0 0 2px 0;">
            <strong style="font-size: 17px; color: #1f363d;">{{nombre}}</strong>
          </td>
        </tr>
        <tr>
          <td style="padding: 0 0 10px 0;">
            <span style="font-size: 12px; color: #40798c; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">{{cargo}}</span>
          </td>
        </tr>
        <tr>
          <td style="padding: 0 0 5px 0; border-top: 1px solid #cfe0c3; padding-top: 10px;">
            <span style="font-size: 12px; color: #40798c; font-weight: bold;">E: </span>
            <a href="mailto:{{email}}" style="font-size: 12px; color: #1f363d; text-decoration: none;">{{email}}</a>
          </td>
        </tr>
        <tr>
          <td style="padding: 0 0 5px 0;">
            <span style="font-size: 12px; color: #40798c; font-weight: bold;">T: </span>
            <span style="font-size: 12px; color: #1f363d;">{{telefono}}</span>
          </td>
        </tr>
        {{#website}}
        <tr>
          <td style="padding: 0 0 5px 0;">
            <span style="font-size: 12px; color: #40798c; font-weight: bold;">W: </span>
            <a href="{{{website}}}" style="font-size: 12px; color: #1f363d; text-decoration: none;">{{website}}</a>
          </td>
        </tr>
        {{/website}}
        {{#linkedin}}
        <tr>
          <td style="padding: 0 0 5px 0;">
            <span style="font-size: 12px; color: #40798c; font-weight: bold;">in: </span>
            <a href="{{{linkedin}}}" style="font-size: 12px; color: #1f363d; text-decoration: none;">LinkedIn</a>
          </td>
        </tr>
        {{/linkedin}}
      </table>
    </td>
  </tr>
</table>
