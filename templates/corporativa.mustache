<!-- Email Signature: Corporativa -->
<!-- Two-column table: photo left, contact info right -->
<table cellpadding="0" cellspacing="0" border="0" style="width:550px;font-family:Arial,Helvetica,sans-serif;color:#333333;border-collapse:collapse;">
  <tr>
    <td style="vertical-align:top;width:240px;padding:0;">
      <img src="{{{bannerUrl}}}" width="240" height="184" alt="{{nombre}}" style="display:block;border:0;width:240px;height:184px;object-fit:cover;" />
    </td>
    <td style="vertical-align:top;padding:0 0 0 20px;">
      <table cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
        <tr>
          <td style="padding:0 0 4px 0;">
            <strong style="font-size:16px;color:#1a1a2e;">{{nombre}}</strong>
          </td>
        </tr>
        <tr>
          <td style="padding:0 0 12px 0;">
            <span style="font-size:13px;color:#4a4a68;">{{cargo}}</span>
          </td>
        </tr>
        <tr>
          <td style="padding:0 0 6px 0;border-top:1px solid #e0e0e0;padding-top:12px;">
            <span style="font-size:12px;color:#555555;">&#9993; </span>
            <a href="mailto:{{email}}" style="font-size:12px;color:#2563eb;text-decoration:none;">{{email}}</a>
          </td>
        </tr>
        <tr>
          <td style="padding:0 0 6px 0;">
            <span style="font-size:12px;color:#555555;">&#9742; </span>
            <span style="font-size:12px;color:#333333;">{{telefono}}</span>
          </td>
        </tr>
        {{#website}}
        <tr>
          <td style="padding:0 0 6px 0;">
            <span style="font-size:12px;color:#555555;">&#127760; </span>
            <a href="{{{website}}}" style="font-size:12px;color:#2563eb;text-decoration:none;">{{website}}</a>
          </td>
        </tr>
        {{/website}}
        {{#linkedin}}
        <tr>
          <td style="padding:0 0 6px 0;">
            <span style="font-size:12px;color:#555555;">in </span>
            <a href="{{{linkedin}}}" style="font-size:12px;color:#2563eb;text-decoration:none;">LinkedIn</a>
          </td>
        </tr>
        {{/linkedin}}
      </table>
    </td>
  </tr>
</table>
