<!-- Email Signature: Corporativa -->
<!-- Two-column: photo left, separator, contact info right. Outlook-compatible. -->
<table cellpadding="0" cellspacing="0" border="0" style="width: 550px; font-family: Arial, Helvetica, sans-serif; border-collapse: collapse;">
  <tr>
    <!-- Photo -->
    <td width="140" valign="top" style="vertical-align: top; padding: 0;">
      <img src="{{{bannerUrl}}}" alt="{{nombre}}" width="130" height="130" style="display: block; width: 130px; height: 130px;" />
    </td>

    <!-- Separator -->
    <td width="20" valign="top" style="vertical-align: top; padding: 10px 0;">
      <table cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse;">
        <tr><td style="width: 2px; height: 110px; background-color: #9ec1a3;" bgcolor="#9ec1a3">&nbsp;</td></tr>
      </table>
    </td>

    <!-- Contact Info -->
    <td valign="top" style="vertical-align: top; padding: 5px 0 0 0;">
      <table cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse;">
        <!-- Name -->
        <tr>
          <td colspan="2" style="padding: 0 0 2px 0; font-size: 17px; font-weight: bold; color: #1f363d; font-family: Arial, Helvetica, sans-serif;">
            {{nombre}}
          </td>
        </tr>
        <!-- Title -->
        <tr>
          <td colspan="2" style="padding: 0 0 10px 0; font-size: 12px; font-weight: 600; color: #40798c; letter-spacing: 0.5px; font-family: Arial, Helvetica, sans-serif;">
            {{cargo}}
          </td>
        </tr>
        <!-- Separator line -->
        <tr>
          <td colspan="2" style="padding: 0 0 10px 0; border-top: 1px solid #cfe0c3; font-size: 1px; line-height: 1px;">&nbsp;</td>
        </tr>
        <!-- Email -->
        <tr>
          <td style="font-size: 12px; font-weight: bold; color: #40798c; padding-right: 4px; font-family: Arial, Helvetica, sans-serif;">E:</td>
          <td style="font-size: 12px; color: #1f363d; padding-bottom: 5px; font-family: Arial, Helvetica, sans-serif;"><a href="mailto:{{email}}" style="color: #1f363d; text-decoration: none;">{{email}}</a></td>
        </tr>
        <!-- Phone -->
        <tr>
          <td style="font-size: 12px; font-weight: bold; color: #40798c; padding-right: 4px; font-family: Arial, Helvetica, sans-serif;">T:</td>
          <td style="font-size: 12px; color: #1f363d; padding-bottom: 5px; font-family: Arial, Helvetica, sans-serif;">{{telefono}}</td>
        </tr>
        <!-- Website -->
        {{#website}}
        <tr>
          <td style="font-size: 12px; font-weight: bold; color: #40798c; padding-right: 4px; font-family: Arial, Helvetica, sans-serif;">W:</td>
          <td style="font-size: 12px; color: #1f363d; padding-bottom: 5px; font-family: Arial, Helvetica, sans-serif;"><a href="{{{website}}}" style="color: #1f363d; text-decoration: none;">{{website}}</a></td>
        </tr>
        {{/website}}
        <!-- LinkedIn -->
        {{#linkedin}}
        <tr>
          <td style="font-size: 12px; font-weight: bold; color: #40798c; padding-right: 4px; font-family: Arial, Helvetica, sans-serif;">in:</td>
          <td style="font-size: 12px; color: #1f363d; padding-bottom: 5px; font-family: Arial, Helvetica, sans-serif;"><a href="{{{linkedin}}}" style="color: #1f363d; text-decoration: none;">LinkedIn</a></td>
        </tr>
        {{/linkedin}}
      </table>
    </td>
  </tr>
</table>
