<!-- Email Signature: Minimalista -->
<!-- Single row: avatar + name | cargo | contact inline, ultra compact -->
<table cellpadding="0" cellspacing="0" border="0" style="width:480px;font-family:Arial,Helvetica,sans-serif;color:#333333;border-collapse:collapse;">
  <tr>
    <td style="vertical-align:middle;width:80px;padding:0;">
      <img src="{{{bannerUrl}}}" width="80" height="80" alt="{{nombre}}" style="display:block;border:0;width:80px;height:80px;border-radius:40px;object-fit:cover;" />
    </td>
    <td style="vertical-align:middle;padding:0 0 0 14px;">
      <table cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
        <tr>
          <td style="padding:0 0 2px 0;">
            <strong style="font-size:14px;color:#111827;">{{nombre}}</strong>
            <span style="font-size:12px;color:#6b7280;"> &mdash; {{cargo}}</span>
          </td>
        </tr>
        <tr>
          <td style="padding:2px 0 0 0;">
            <a href="mailto:{{email}}" style="font-size:12px;color:#2563eb;text-decoration:none;">{{email}}</a>
            <span style="font-size:12px;color:#9ca3af;"> &bull; </span>
            <span style="font-size:12px;color:#333333;">{{telefono}}</span>
            {{#website}}
            <span style="font-size:12px;color:#9ca3af;"> &bull; </span>
            <a href="{{{website}}}" style="font-size:12px;color:#2563eb;text-decoration:none;">Web</a>
            {{/website}}
            {{#linkedin}}
            <span style="font-size:12px;color:#9ca3af;"> &bull; </span>
            <a href="{{{linkedin}}}" style="font-size:12px;color:#2563eb;text-decoration:none;">LinkedIn</a>
            {{/linkedin}}
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
