# === Environment Configuration ===

# Mode: "local" for development (mocks S3, skips image-tools), "aws" for production
APP_MODE=local

# S3 Configuration
S3_BUCKET_NAME=signature-generator-assets
AWS_REGION=us-east-1

# Image-tools external API
IMAGE_TOOLS_URL=http://localhost:3001/api/v1/image/image-process
IMAGE_TOOLS_API_KEY=your-api-key-here
BACKGROUND_TEMPLATE_URL=https://your-bucket.s3.amazonaws.com/backgrounds/template.png

# AI Provider: "bedrock" | "azure"
AI_PROVIDER=azure

# Azure OpenAI (for development)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=your-azure-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# AWS Bedrock (for demo/production)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_REGION=us-east-1

# Admin
ADMIN_PASSWORD_HASH=your-sha256-hash-here

# Local dev server
PORT=3000
