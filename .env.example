# =====================================================================
#  Email Signature Generator — Configuración de entorno
# =====================================================================
#  Copia este archivo a `.env` y ajusta los valores:
#      cp .env.example .env   (o:  Copy-Item .env.example .env)
#
#  Sin configurar nada (valores por defecto) el proyecto funciona SIN AWS y
#  SIN IA real:
#    - El dev server sirve el frontend + la API en http://localhost:3005
#    - El almacenamiento es local (lambda/local-storage), controlado por
#      STORAGE_PROVIDER=local (default)
#    - La extracción de campos con IA usa un "mock" por regex si no pones
#      credenciales de AI_PROVIDER
# =====================================================================

# ---------------------------------------------------------------------
# Servidor local (frontend + API)
# ---------------------------------------------------------------------
# Puerto del dev server. Default: 3005.
PORT=3005

# =====================================================================
#  ALMACENAMIENTO — elige UN proveedor
# =====================================================================
# STORAGE_PROVIDER define dónde se guardan las imágenes.
#   "local" : filesystem (dev) — no configura nada de abajo.
#   "s3"    : AWS S3          — rellena el bloque "S3 (AWS)".
#   "azure" : Azure Storage   — rellena el bloque "Azure Storage".
# NO es necesario completar ambos bloques; solo el que uses.
STORAGE_PROVIDER=local

# ----- Si elegiste S3 (AWS) -------------------------------------------
# Nombre del bucket S3 para subir imágenes (fotos, banners, fondos).
S3_BUCKET_NAME=signature-generator-assets
# Región de AWS por defecto (también fallback de Bedrock).
AWS_REGION=us-east-1

# ----- Si elegiste Azure Storage --------------------------------------
# Nombre de tu storage account de Azure (sin espacios).
AZURE_ACCOUNT_NAME=
# Clave de acceso primaria/secundaria del storage account.
AZURE_ACCOUNT_KEY=
# Nombre del container donde se subirán los blobs (debe existir).
AZURE_CONTAINER_NAME=

# ---------------------------------------------------------------------
# Servicio externo de procesamiento de imagen (image-tools) — OPCIONAL
# ---------------------------------------------------------------------
# Fusiona la foto de la persona con el fondo para generar el banner.
# Si lo dejas vacío o el servicio no responde, el sistema usa la foto
# original como banner (fallback local). Ejemplo local:
#   http://localhost:3006/api/v1/image/image-process
IMAGE_TOOLS_URL=http://localhost:3006/api/v1/image/image-process
# API key para consumir image-tools (solo si el servicio la requiere).
IMAGE_TOOLS_API_KEY=your-api-key-here
# URL del fondo por defecto para los banners (se usa si no subes uno custom).
BACKGROUND_TEMPLATE_URL=https://your-bucket.s3.amazonaws.com/backgrounds/template.png

# =====================================================================
#  INTELIGENCIA ARTIFICIAL — elige UN proveedor
# =====================================================================
# AI_PROVIDER decide qué motor de IA se usa para extraer los campos de
# contacto desde texto libre. Solo llenas UNO de los dos bloques de abajo,
# según el proveedor que elijas. NO es necesario completar ambos.
#
#   - Para usar AZURE => AI_PROVIDER=azure   (rellena el bloque "Azure OpenAI")
#   - Para usar AWS   => AI_PROVIDER=bedrock (rellena el bloque "AWS Bedrock")
#
# Si el proveedor elegido no tiene credenciales, en modo local la app cae
# a un extractor "mock" por regex — útil para probar el flujo sin IA.

# Proveedor de IA: "azure" | "bedrock"
AI_PROVIDER=azure

# ----- Si elegiste AZURE (AI_PROVIDER=azure) -----------------------------
# Endpoint según el formato de tu recurso:
#   Antiguo (por recurso):  https://<nombre>.openai.azure.com                (sin /openai)
#   Nuevo (AI Services):    https://<nombre>.services.ai.azure.com/openai/v1 (base completa)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# API key del recurso (clave 1 o 2).
AZURE_OPENAI_KEY=your-azure-key-here
# Nombre del deployment (o modelo) desplegado (ej: gpt-4o-mini, gpt-5.2).
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# Formato del endpoint: "auto" (detecta por el sufijo), "legacy" u "openai".
AZURE_OPENAI_API_STYLE=auto
# Versión de API de Azure OpenAI (ajústala según tu región y modelo).
#   Endpoint antiguo (<recurso>.openai.azure.com): usa una versión con fecha, ej. 2024-10-21.
#   Endpoint nuevo (.../openai/v1): usa "preview" (o una versión "-preview").
#   Si usas el endpoint nuevo con una versión con fecha antigua, el sistema
#   la corrige automáticamente a "preview" y muestra un aviso en el log.
AZURE_OPENAI_API_VERSION=2024-10-21
# API a usar: "chat" (Chat Completions) o "responses" (Responses API + streaming).
# "responses" solo funciona con el endpoint nuevo (termina en /openai/v1).
AZURE_OPENAI_API_TYPE=chat
# Depuración: pon en "true" para que el log muestre URL y body del request a Azure
# (muy útil si falla la conexión). La key se enmascara, nunca se imprime completa.
AZURE_OPENAI_DEBUG=false

# ----- Si elegiste AWS (AI_PROVIDER=bedrock) -----------------------------
# ID del modelo disponible en Amazon Bedrock, p. ej.:
#   anthropic.claude-3-haiku-20240307-v1:0  (rápido y económico)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# Región donde tienes habilitado Bedrock (normalmente us-east-1).
BEDROCK_REGION=us-east-1
# Nota: Bedrock usa las credenciales/roles de AWS (aws configure o IAM);
# no necesita una API key propia en esta variable.

# =====================================================================
#  STORAGE PERSONALIZADO POR PLANTILLA (banner) — OPCIONAL
# =====================================================================
# Una plantilla puede declarar en su config.json (lambda/templates/{id}/
# config.json) un destino FTP/SFTP propio para su banner final, en vez de
# usar STORAGE_PROVIDER. El config.json NUNCA lleva credenciales (se
# versiona junto a la plantilla); las credenciales van aquí, con esta
# convención de nombre por plantilla:
#   FTP_<ID_DE_PLANTILLA_EN_MAYUS>_USER
#   FTP_<ID_DE_PLANTILLA_EN_MAYUS>_PASSWORD
# Ejemplo para una plantilla con id "cliente-x":
#   FTP_CLIENTE_X_USER=usuario
#   FTP_CLIENTE_X_PASSWORD=clave-secreta
# Ver docs/local-development.md → "Storage personalizado por plantilla".

# ---------------------------------------------------------------------
# Panel Admin
# ---------------------------------------------------------------------
# Hash SHA-256 del password para ingresar al panel admin (admin.html).
# Genéralo con:  node scripts/generate-hash.js tuPassword
# Deja el valor vacío si no usas el panel.
ADMIN_PASSWORD_HASH=your-sha256-hash-here

